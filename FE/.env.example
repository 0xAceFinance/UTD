# Copy to .env.local and fill in. Never commit real keys: .env* is gitignored
# except this file, and every value below is a placeholder or a public
# Anvil test value.

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/mcapduel

# --- Chain / contracts (public, shipped to the browser) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Required here: config/contracts.ts only hardcodes a source-of-truth default
# for known production chain IDs (currently just 4663, Robinhood Chain
# mainnet); a local Anvil deployment's address is different every time
# Contracts/script/DeployDuel.s.sol runs, so it has to come from env. Paste
# the factory address DeployDuel.s.sol just printed.
NEXT_PUBLIC_BATTLE_ESCROW_FACTORY_ADDRESS=
# Must be the factory's approvedStakeToken. Decimals are read from the token
# (18 for the local MockERC20, 6 for USDC) -- nothing to configure here.
NEXT_PUBLIC_STAKE_TOKEN_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Oracle signer (server only) ---
# Signs every settle()/voidActive() result. Must match the factory's
# oracleSigner. In production use a KMS-backed signer, not a plain env var.
ORACLE_SIGNER_PRIVATE_KEY=
# Optional, only for ~24h after an oracle signer rotation
# (proposeOracleSigner -> executeOracleSignerRotation). Each escrow checks
# the signer it captured at activation (settlementSigner()), so duels
# activated before the rotation still need the old key. Set this to the OLD
# key and ORACLE_SIGNER_PRIVATE_KEY to the new one; remove it once every
# pre-rotation duel has settled or refunded.
ORACLE_SIGNER_PRIVATE_KEY_PREVIOUS=

# --- Settlement relayer (server only) ---
# A SEPARATE hot wallet that submits settle() on-chain for signed duels
# (lib/settlementRelayer.ts), so winners are paid before refundStale()
# opens at endTime + 24h. Needs only a small ETH balance for gas and no
# on-chain role. Must NOT be the oracle signer key (the relayer refuses it).
# Unset = no automatic payouts; players must click "Trigger escrow payout".
RELAYER_PRIVATE_KEY=

# --- Cron (server only) ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/settle.
# Use a long random value (e.g. `openssl rand -hex 32`). Unset = the cron
# endpoint rejects every call.
CRON_SECRET=
# Optional: webhook (Slack/Discord-compatible JSON {"text": ...}) alerted when
# a HELD duel is still unresolved 12h after its endTime.
ALERT_WEBHOOK_URL=

# --- Admin ---
# Shared secret for /api/admin/** (x-admin-secret header).
ADMIN_API_SECRET=

# --- Optional tuning ---
# FUNDING_SOURCE_LOOKBACK_BLOCKS=
