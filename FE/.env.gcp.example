# GCP (backend) environment. Set these as Cloud Run env vars, with the
# secrets (everything except the NEXT_PUBLIC_* block) sourced from Secret
# Manager rather than plain env vars -- none of these belong on Vercel.
# This deployment serves /api/* for real; its own pages are built but never
# routed to in production.

# --- Chain / contracts ---
# Read directly by server-side lib code (chainVerify.ts, settlementRelayer.ts,
# chainClient.ts, fundingSource.ts) via process.env -- NOT just a browser
# value, despite the NEXT_PUBLIC_ prefix. Must be set here too.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Leave these two unset in production: config/contracts.ts hardcodes the
# current mainnet (chain 4663) addresses by chain ID and IGNORES these env
# vars entirely for that chain -- setting them here has no effect, and there
# is no env var anywhere that can override the hardcoded value, so Vercel
# and Cloud Run always resolve to the identical address with zero chance of
# drift (a stale value here used to be exactly how "DuelCreated event not
# found" happened, see Deployment.md's troubleshooting table). They only
# matter for a chain ID with no entry in that map -- local Anvil dev.
NEXT_PUBLIC_BATTLE_ESCROW_FACTORY_ADDRESS=
NEXT_PUBLIC_STAKE_TOKEN_ADDRESS=
NEXT_PUBLIC_UTD_X_URL=https://x.com/UTD_RHC
NEXT_PUBLIC_UTD_TELEGRAM_URL=https://t.me/utd_rh

# --- Database ---
MONGODB_URI=

# --- Oracle signer (Secret Manager) ---
# Signs every settle()/voidActive() result. Must match the factory's
# oracleSigner. Plain env var is a stopgap -- KMS-backed signing is the
# real target, see lib/oracleSigner.ts.
ORACLE_SIGNER_PRIVATE_KEY=
# Optional, only for ~24h after an oracle signer rotation.
ORACLE_SIGNER_PRIVATE_KEY_PREVIOUS=

# --- Settlement relayer (Secret Manager) ---
# Separate hot wallet that submits settle() on-chain (lib/settlementRelayer.ts).
# Must NOT be the oracle signer key. Unset = no automatic payouts.
RELAYER_PRIVATE_KEY=

# --- Cron (Secret Manager) ---
# Cloud Scheduler sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/settle directly (not through the Vercel proxy). Unset = the cron
# endpoint rejects every call.
CRON_SECRET=
# Optional: webhook (Slack/Discord-compatible JSON {"text": ...}) alerted when
# a HELD duel is still unresolved 12h after its endTime.
ALERT_WEBHOOK_URL=

# --- Admin (Secret Manager) ---
# Shared secret for /api/admin/** (x-admin-secret header).
ADMIN_API_SECRET=

# --- Optional tuning ---
# FUNDING_SOURCE_LOOKBACK_BLOCKS=
