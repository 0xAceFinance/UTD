# Vercel (FE) environment. Set these in the Vercel project settings.
# This deployment only serves pages -- /api/* is proxied to the GCP backend
# (see next.config.mjs rewrites) and never runs against this env directly.
# No secrets belong here: everything below is either NEXT_PUBLIC_ (shipped to
# the browser anyway) or a plain backend URL.

# --- Where Vercel proxies /api/* to ---
BACKEND_API_URL=https://<your-cloud-run-service-url>

# --- Chain / contracts (public, shipped to the browser) ---
NEXT_PUBLIC_CHAIN_ID=4663
# Leave these three unset: config/contracts.ts hardcodes the current mainnet
# (chain 4663) addresses AND rpc url by chain ID and IGNORES these env vars
# entirely for that chain -- setting one here has no effect, so this
# deployment and Cloud Run always resolve to the identical config with no
# dashboard to keep in sync. They only matter for a chain ID with no entry
# in that map -- local Anvil dev.
NEXT_PUBLIC_BATTLE_ESCROW_FACTORY_ADDRESS=
NEXT_PUBLIC_STAKE_TOKEN_ADDRESS=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
