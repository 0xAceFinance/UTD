# --- Chain connection (fill in once Robinhood Chain details are confirmed) ---
# RPC endpoint for Robinhood Chain (or any EVM chain to point the engine at for now).
CHAIN_RPC_URL=
CHAIN_ID=

# Which DEX factory contracts to index. The reader assumes a Uniswap-V2-style
# pool interface (getReserves/token0/token1). Comma-separated addresses.
DEX_FACTORY_ADDRESSES=

# --- Data source mode ---
# "mock"  -> use the synthetic in-memory data source (no chain access, default, safe for dev)
# "chain" -> read live pool reserves via CHAIN_RPC_URL
DATA_SOURCE=mock
